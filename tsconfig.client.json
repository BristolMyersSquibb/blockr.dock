{
  // The dock's client is the TypeScript in srcts/ that esbuild bundles into
  // inst/js for the browser. It is written against the types that blockr.core
  // ships, which each npm script installs first, as @blockr/core.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleDetection": "force",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.client.tsbuildinfo"
  },
  "include": ["srcts"],
  "exclude": ["srcts/build", "srcts/**/*.test.ts", "srcts/**/*.test.tsx"]
}
